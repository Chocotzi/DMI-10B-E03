{
  "name": "dmi-react-native-starter",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "backend": "node course-backend/server.mjs",
    "backend:self-test": "node course-backend/self-test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --no-watchman --cacheDirectory .jest-cache",
    "test:smoke": "jest --no-watchman --cacheDirectory .jest-cache --ci --runInBand course-tests/smoke.test.tsx",
    "test:coverage:week11": "jest --no-watchman --cacheDirectory .jest-cache --ci --runInBand --coverage --coverageReporters=json-summary --coverageReporters=text --collectCoverageFrom=src/course-evaluation/index.ts --coverageThreshold='{\"global\":{\"branches\":60,\"functions\":65,\"lines\":70,\"statements\":70}}' course-tests/smoke.test.tsx course-tests/public/week-01.test.ts course-tests/public/week-02.test.ts course-tests/public/week-03.test.ts course-tests/public/week-04.test.ts course-tests/public/week-05.test.ts course-tests/public/week-06.test.ts course-tests/public/week-08.test.ts course-tests/public/week-09.test.ts course-tests/public/week-10.test.ts course-tests/public/week-11.test.ts",
    "audit:ci": "npm audit --omit=dev --audit-level=critical",
    "bundle:release": "expo export --platform android --output-dir dist/export",
    "native:generate": "expo prebuild --platform android --no-install",
    "package:android:ci": "npm run native:generate && ./android/gradlew -p android assembleDebug",
    "package:android": "npm run native:generate && ./android/gradlew -p android assembleRelease"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/course-tests/hidden/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/course-evaluation/contracts.ts"
    ]
  },
  "overrides": {
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    },
    "@react-native/community-cli-plugin@0.86.2": {
      "metro": "0.84.5",
      "metro-config": "0.84.5",
      "metro-core": "0.84.5"
    }
  }
}
